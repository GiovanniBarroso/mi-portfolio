{
  "name": "mi-portfolio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Portfolio personal de Giovanni Barroso — Vue 3, TypeScript y Tailwind CSS 4.",
  "homepage": "https://giovannibarroso.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/GiovanniBarroso/mi-portfolio"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.19",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "images:optimize": "node scripts/optimize-images.mjs",
    "prepare": "husky",
    "ci:check": "pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "og": "node scripts/generate-og.mjs"
  },
  "lint-staged": {
    "*.{ts,vue,js,mjs}": [
      "prettier -w",
      "eslint --fix --max-warnings 0"
    ],
    "*.{css,md,json,html,yml,yaml}": [
      "prettier -w"
    ]
  },
  "dependencies": {
    "@unhead/vue": "^1.11.20",
    "vue": "^3.5.39",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.13.3",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.5",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.2",
    "typescript": "~5.8.3",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7"
  }
}
